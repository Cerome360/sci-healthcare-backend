// SCI Healthcare — indexer schema.
//
// This database is a read model built from on-chain events. It is a cache,
// never a source of truth: every row here can be rebuilt by replaying the
// ledger. Nothing is written here that is not already public on chain,
// which is what keeps a database breach from becoming a health-data breach.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite locally; switch to "postgresql" for deployment.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Tracks all contract deployments, including historical redeployments.
/// Each row represents one contract instance deployed at a specific ledger.
model Deployment {
  id         Int    @id @default(autoincrement())
  type       String // registry | voucher | receipt
  contractId String @unique
  fromLedger Int
  toLedger   Int?   // null means still active
  createdAt  DateTime @default(now())

  providers Provider[]
  vouchers Voucher[]
  receipts Receipt[]

  @@index([type])
}

model Provider {
  address      String   @id
  name         String
  country      String
  status       String   // Pending | Active | Suspended
  registeredAt DateTime
  updatedAt    DateTime @updatedAt

  /// Which deployment this provider was registered under.
  deployment Deployment? @relation(fields: [deploymentId], references: [id])
  deploymentId Int?

  services Service[]
  vouchers Voucher[]

  @@index([status])
  @@index([country])
}

model Service {
  id       String  @id // "{providerAddress}:{code}"
  code     Int
  label    String
  price    String  // i128 as decimal string; JS numbers cannot hold these
  active   Boolean @default(true)

  provider        Provider @relation(fields: [providerAddress], references: [address])
  providerAddress String

  @@unique([providerAddress, code])
  @@index([code])
}

model Voucher {
  id              String    @id // on-chain u64 as string
  /// Numeric mirror of `id`, and the only correct way to order vouchers by
  /// id: `id` is a string, so `ORDER BY id` is lexicographic and puts
  /// voucher 10 before voucher 9 (issue #61).
  ///
  /// Written from `id` by the `voucher_created` handler (see
  /// `voucherSeq()` in `src/lib/voucher_seq.ts`) and backfilled for rows that
  /// predate it by migration `20260106000000_voucher_seq`. Nullable because
  /// a voucher id is a u64 in principle and locally-authored fixtures use
  /// label ids (`bulk-0001`); those rows have no numeric id to mirror and
  /// sort after every real one. `BigInt` rather than `Int` because the local
  /// seed id space alone starts at 9e12, past the range of a 32-bit int.
  /// Never exposed by an API response.
  seq             BigInt?
  funder          String
  beneficiaryRef  String    // opaque 32-byte hex. Not reversible to an identity.
  serviceCode     Int
  amount          String    // i128 as decimal string
  status          String    // Funded | Claimed | Attested | Settled | Disputed | Refunded
  createdAt       DateTime
  expiresAt       DateTime
  claimedAt       DateTime?
  attestedAt      DateTime?
  /// Attester that signed the attestation, from the voucher_attested topic.
  /// Nullable so `prisma db push` adds it in place on the existing database.
  attestedBy      String?
  disputeDeadline DateTime?
  /// reason_code from voucher_disputed; meanings are documented in
  /// docs/protocol/lifecycle.md. The contract treats it as opaque.
  disputeReason   Int?
  /// How the dispute ended, from dispute_resolved. `disputeOutcome` is
  /// 'Funder' when the funder was refunded, otherwise 'Provider'.
  disputeResolvedAt DateTime?
  disputeResolvedBy String?
  disputeOutcome    String?
  settledNet      String?
  settledFee      String?
  /// When the voucher was refunded, from the voucher_refunded event's
  /// ledger close time. Null until a refund is observed. This is what makes
  /// the daily activity series able to bucket refunds by day.
  refundedAt      DateTime?
  updatedAt       DateTime  @updatedAt

  provider        Provider @relation(fields: [providerAddress], references: [address])
  providerAddress String

  /// Which deployment this voucher was created under.
  deployment Deployment? @relation(fields: [deploymentId], references: [id])
  deploymentId Int?

  // Composite indexes for the list routes (issue #58). Each mirrors a real
  // filter + sort path in src/routes/vouchers.ts; the single-column indexes
  // they replace (funder, providerAddress, beneficiaryRef, status) were
  // strict prefixes of these and were dropped. Postgres scans a two-column
  // index backwards, so one index serves `order=asc|desc` for both the
  // filtered count and the keyset page `(sortCol, id)` orders.
  //
  // GET /vouchers?funder=...        ORDER BY createdAt (default sort)
  @@index([funder, createdAt])
  // GET /vouchers?funder=...&sort=expiresAt and GET /vouchers/due?funder=...
  // (status is filtered after the index range; keeping expiresAt last
  // preserves the sort the route asks for).
  @@index([funder, expiresAt])
  // GET /vouchers?provider=...     ORDER BY createdAt
  @@index([providerAddress, createdAt])
  // GET /vouchers?provider=...&sort=expiresAt and GET /vouchers/due?provider=...
  @@index([providerAddress, expiresAt])
  // GET /vouchers?beneficiaryRef=... ORDER BY createdAt
  @@index([beneficiaryRef, createdAt])
  // GET /vouchers?status=... (single or comma-separated) and the
  // `status: 'Settled'` scan behind GET /stats, each sorted by createdAt.
  @@index([status, createdAt])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([refundedAt])
  @@index([attestedBy])
}

/// An attester trusted to confirm care, as announced on the registry.
///
/// `active` reflects the latest attester_added / attester_removed observed;
/// the row is kept after removal so vouchers that cite it still resolve a
/// name and the history of who could attest is not lost. New table, so
/// `prisma db push` creates it without touching existing rows.
model Attester {
  address   String    @id
  active    Boolean   @default(true)
  addedAt   DateTime
  removedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@index([active])
}

model Receipt {
  voucherId       String   @id
  beneficiaryRef  String
  providerAddress String
  serviceCode     Int
  amount          String
  settledAt       DateTime

  /// Which deployment this receipt was settled under.
  deployment Deployment? @relation(fields: [deploymentId], references: [id])
  deploymentId Int?

  // GET /receipts lists one patient's or one clinic's history sorted by
  // settledAt desc (tie-broken by the voucherId primary key), and the same
  // predicate drives the count and the totalSpend aggregation on that
  // route. These replace the single-column beneficiaryRef / providerAddress
  // indexes they strictly prefix (issue #58).
  @@index([beneficiaryRef, settledAt])
  @@index([providerAddress, settledAt])
}

/// Every admin proposal and handover observed on each contract.
///
/// Who controls a protocol's admin keys is due diligence, so the history is
/// kept rather than only the current holder. Keyed by the on-chain event id
/// so replay is idempotent.
model GovernanceEvent {
  id           String   @id // on-chain event id
  contractId   String
  contract     String // registry | voucher | receipt
  kind         String // Proposed | Changed
  admin        String // proposing admin (Proposed) or new admin (Changed)
  pendingAdmin String? // nominee, for Proposed
  ledger       Int
  occurredAt   DateTime

  @@index([contract, ledger])
}

/// Every observed status transition for a clinic.
///
/// Only the current status lives on `Provider`; this keeps when and how
/// often a clinic was suspended, which is context a funder needs.
model ProviderStatusChange {
  id              String   @id // on-chain event id
  providerAddress String
  status          String // Pending | Active | Suspended
  ledger          Int
  changedAt       DateTime

  @@index([providerAddress, ledger])
}

/// Every observed price change for a provider's service.
///
/// `Service` holds only the current price; this records how it changed.
/// A label-only upsert does not write here.
model ServicePriceChange {
  id              String   @id // on-chain event id
  providerAddress String
  code            Int
  price           String // i128 as decimal string
  ledger          Int
  changedAt       DateTime

  @@index([providerAddress, code, ledger])
}

/// Append-only log of every contract event the indexer processes.
///
/// The projection tables only hold the latest state; this keeps what
/// happened, in ledger order, with the transaction that proved it. `id` is
/// the RPC event id, so replaying a page upserts rather than duplicates.
/// `voucherId` is null for events that are not about a voucher.
model ContractEvent {
  id         String   @id // RPC event id, unique
  contractId String
  contract   String // registry | voucher | receipt
  name       String
  ledger     Int
  txHash     String
  closedAt   DateTime
  voucherId  String?
  /// Decoded fields serialised as JSON. Addresses and amounts are stored
  /// as strings, never JS numbers, because i128 loses precision above 2^53.
  /// Text rather than a native JSON column: SQLite has no JSON type and
  /// tests run on both engines.
  data       String

  @@index([voucherId, ledger])
}

/// An event the indexer could not project.
///
/// The cursor moves past a failing event so one bad payload cannot wedge the
/// pipeline, which means the read model is missing that event. This table is
/// what makes the omission durable and visible: `/ready` reports degraded
/// while it is non-empty, and `npm run indexer:retry-failed` replays it.
model FailedEvent {
  id        String   @id // on-chain event id
  name      String
  ledger    Int
  /// JSON of the raw RPC event with topics and value as base64 XDR, enough
  /// to re-decode it after a decoder fix.
  raw       String
  error     String
  attempts  Int      @default(1)
  firstSeen DateTime
  lastSeen  DateTime

  @@index([ledger])
}

/// Single-row table tracking how far the indexer has replayed the ledger,
/// and which process is currently allowed to advance it.
///
/// The lease is what keeps two indexers (a deploy overlap, or an API scaled
/// past one replica) from racing on the cursor. It lives here rather than in
/// a Postgres advisory lock so the exact same code path is exercised on the
/// SQLite database used in development and tests.
model IndexerState {
  id             Int       @id @default(1)
  lastLedger     Int
  updatedAt      DateTime  @updatedAt
  /// Instance holding the lease; null when no one is indexing.
  leaseOwner     String?
  /// After this instant the lease is free for another instance to take.
  leaseExpiresAt DateTime?
  /// True when the cursor fell outside the RPC retention window.
  gap            Boolean   @default(false)
  /// Oldest ledger the RPC had when the gap was detected.
  gapOldestLedger Int?
  /// Cursor ledger at the time the gap was detected.
  gapCursorLedger Int?
}

/// One drip from the testnet demo faucet.
///
/// Keyed by the on-chain event id rather than counted into a single row, so
/// a replay is idempotent like every other handler. Keeping the wallet is
/// what lets `/stats` separate "how many drips" from "how many people".
/// Only populated when `FAUCET_CONTRACT_ID` is configured.
model FaucetDrip {
  id        String   @id // on-chain event id
  wallet    String
  amount    String // i128 as decimal string
  ledger    Int
  drippedAt DateTime

  @@index([wallet])
  @@index([ledger])
}

/// A voucher whose stored row disagrees with the contract.
///
/// The read model is a cache of the chain, and a missed or mis-decoded event
/// leaves it quietly wrong. `npm run indexer:reconcile` compares stored
/// vouchers against `get_voucher` and writes what it found here; the row is
/// deleted as soon as a later run (or `--fix`) sees them agree, so a
/// non-empty table always means open drift.
model ReconcileMismatch {
  voucherId String   @id
  /// field_mismatch | missing_on_chain
  kind      String
  /// JSON array of `{ field, db, chain }`, one entry per differing field.
  fields    String
  /// How many consecutive runs have seen this mismatch.
  runs      Int      @default(1)
  firstSeen DateTime
  lastSeen  DateTime

  @@index([kind])
}

/// Webhook delivery outbox.
///
/// A row is written in the same transaction as the projection it describes,
/// so an event that fails to project is never announced. Delivery happens in
/// a separate loop, which keeps a slow or dead endpoint from stalling the
/// indexer. One row per configured endpoint, so each endpoint retries and
/// backs off independently.
///
/// The exact JSON body is stored rather than rebuilt on retry: the signature
/// covers those bytes, and a retry has to send the same request in order to
/// be verifiable. The payload deliberately contains no beneficiary reference.
model WebhookDelivery {
  id            String    @id
  url           String
  event         String
  voucherId     String
  status        String
  txHash        String?
  ledger        Int
  payload       String
  attempts      Int       @default(0)
  /// When a retry becomes due.
  nextAttemptAt DateTime
  deliveredAt   DateTime?
  /// Set when delivery is given up on: too many attempts, or a permanent
  /// response such as a 404. Never retried again once set.
  abandonedAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([deliveredAt, abandonedAt, nextAttemptAt])
}
