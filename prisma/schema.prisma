// SCI Healthcare — indexer schema.
//
// This database is a read model built from on-chain events. It is a cache,
// never a source of truth: every row here can be rebuilt by replaying the
// ledger. Nothing is written here that is not already public on chain,
// which is what keeps a database breach from becoming a health-data breach.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite locally; switch to "postgresql" for deployment.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Provider {
  address      String   @id
  name         String
  country      String
  status       String   // Pending | Active | Suspended
  registeredAt DateTime
  updatedAt    DateTime @updatedAt

  services Service[]
  vouchers Voucher[]

  @@index([status])
  @@index([country])
}

model Service {
  id       String  @id // "{providerAddress}:{code}"
  code     Int
  label    String
  price    String  // i128 as decimal string; JS numbers cannot hold these
  active   Boolean @default(true)

  provider        Provider @relation(fields: [providerAddress], references: [address])
  providerAddress String

  @@unique([providerAddress, code])
  @@index([code])
}

model Voucher {
  id              String    @id // on-chain u64 as string
  funder          String
  beneficiaryRef  String    // opaque 32-byte hex. Not reversible to an identity.
  serviceCode     Int
  amount          String    // i128 as decimal string
  status          String    // Funded | Claimed | Attested | Settled | Disputed | Refunded
  createdAt       DateTime
  expiresAt       DateTime
  claimedAt       DateTime?
  attestedAt      DateTime?
  disputeDeadline DateTime?
  /// reason_code from voucher_disputed; meanings are documented in
  /// docs/protocol/lifecycle.md. The contract treats it as opaque.
  disputeReason   Int?
  settledNet      String?
  settledFee      String?
  updatedAt       DateTime  @updatedAt

  provider        Provider @relation(fields: [providerAddress], references: [address])
  providerAddress String

  @@index([funder])
  @@index([providerAddress])
  @@index([beneficiaryRef])
  @@index([status])
  @@index([expiresAt])
}

model Receipt {
  voucherId       String   @id
  beneficiaryRef  String
  providerAddress String
  serviceCode     Int
  amount          String
  settledAt       DateTime

  @@index([beneficiaryRef])
  @@index([providerAddress])
}

/// Every admin proposal and handover observed on each contract.
///
/// Who controls a protocol's admin keys is due diligence, so the history is
/// kept rather than only the current holder. Keyed by the on-chain event id
/// so replay is idempotent.
model GovernanceEvent {
  id           String   @id // on-chain event id
  contractId   String
  contract     String // registry | voucher | receipt
  kind         String // Proposed | Changed
  admin        String // proposing admin (Proposed) or new admin (Changed)
  pendingAdmin String? // nominee, for Proposed
  ledger       Int
  occurredAt   DateTime

  @@index([contract, ledger])
}

/// Every observed status transition for a clinic.
///
/// Only the current status lives on `Provider`; this keeps when and how
/// often a clinic was suspended, which is context a funder needs.
model ProviderStatusChange {
  id              String   @id // on-chain event id
  providerAddress String
  status          String // Pending | Active | Suspended
  ledger          Int
  changedAt       DateTime

  @@index([providerAddress, ledger])
}

/// Every observed price change for a provider's service.
///
/// `Service` holds only the current price; this records how it changed.
/// A label-only upsert does not write here.
model ServicePriceChange {
  id              String   @id // on-chain event id
  providerAddress String
  code            Int
  price           String // i128 as decimal string
  ledger          Int
  changedAt       DateTime

  @@index([providerAddress, code, ledger])
}

/// Single-row table tracking how far the indexer has replayed the ledger.
model IndexerState {
  id          Int      @id @default(1)
  lastLedger  Int
  updatedAt   DateTime @updatedAt
}
