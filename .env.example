# ---- server ----
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
# /ready reports degraded once the indexer trails the chain by more ledgers
# than this. Raise it for deployments that tolerate a longer catch-up.
READY_MAX_LAG_LEDGERS=120

# ---- database ----
# Local development uses SQLite. Production uses Postgres; swap the
# provider in prisma/schema.prisma to "postgresql" when you do.
DATABASE_URL="file:./dev.db"

# ---- stellar ----
STELLAR_NETWORK=testnet
# One endpoint, or several comma-separated in SOROBAN_RPC_URLS. With more
# than one, repeated failures move the backend to the next: public RPC
# endpoints have outages, and a standby keeps the indexer and /ready healthy.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# SOROBAN_RPC_URLS=https://soroban-testnet.stellar.org,https://your-backup-rpc.example
# Consecutive failures against one endpoint before switching to the next.
SOROBAN_RPC_MAX_FAILURES=3
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ---- contract ids (filled in by scripts/deploy.sh) ----
REGISTRY_CONTRACT_ID=
VOUCHER_CONTRACT_ID=
RECEIPT_CONTRACT_ID=
USDC_CONTRACT_ID=
# Testnet demo faucet. Optional: set it to count drips in /stats.
FAUCET_CONTRACT_ID=

# ---- indexer ----
# Ledger to begin indexing from. Set to the deploy ledger to avoid
# scanning history you do not need. 0 means "start from the current tip".
INDEXER_START_LEDGER=0
INDEXER_POLL_MS=5000
# Ceiling for the exponential backoff applied after RPC failures, so an
# outage is retried ever more slowly instead of every poll interval.
INDEXER_BACKOFF_MAX_MS=60000
# How long SIGTERM/SIGINT waits for the cycle in flight to commit and save
# its cursor before the process exits. Render sends SIGTERM on every deploy.
SHUTDOWN_TIMEOUT_MS=15000

# ---- live stream (GET /stream) ----
# Idle interval between heartbeat frames. What stops a proxy or a mobile
# carrier from closing a connection that is alive but quiet.
SSE_HEARTBEAT_MS=15000
# Open streams this instance will hold. Each one is a socket that is never
# released, so past this a new viewer gets 503 and retries shortly. Raise it
# only with the platform's connection limit in mind.
SSE_MAX_CONNECTIONS=64
