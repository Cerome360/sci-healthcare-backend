{
  "name": "sci-healthcare-backend",
  "version": "0.2.0",
  "private": true,
  "description": "Indexer and API for the SCI Healthcare care-voucher protocol on Stellar",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:api": "tsx watch src/api.ts",
    "dev:indexer": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json && npm run client:generate",
    "client:generate": "tsx scripts/generate-client.ts",
    "client:build": "tsc -p packages/client/tsconfig.json",
    "start": "node dist/index.js",
    "start:api": "node dist/api.js",
    "start:indexer": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "indexer:backfill": "tsx src/scripts/backfill.ts",
    "indexer:retry-failed": "tsx src/scripts/retry-failed.ts",
    "indexer:reconcile": "tsx src/scripts/reconcile.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "loadtest": "node scripts/loadtest.mjs",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/compress": "9.2.2",
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.6.0",
    "@fastify/swagger-ui": "5.2.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/instrumentation-fastify": "0.57.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@prisma/client": "6.19.3",
    "@prisma/instrumentation": "6.19.3",
    "@stellar/stellar-sdk": "17.0.1",
    "fastify": "5.12.1",
    "fastify-type-provider-zod": "2.1.0",
    "pino": "9.6.0",
    "prom-client": "15.1.3",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.23.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.10.5",
    "@vitest/coverage-v8": "2.1.8",
    "autocannon": "8.0.0",
    "eslint": "9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prisma": "6.19.3",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.71.1",
    "vitest": "2.1.8"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix"
    ]
  }
}
