{
  "name": "sci-healthcare-backend",
  "version": "0.2.0",
  "private": true,
  "description": "Indexer and API for the SCI Healthcare care-voucher protocol on Stellar",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/compress": "9.2.2",
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "10.3.0",
    "@prisma/client": "6.19.3",
    "@stellar/stellar-sdk": "17.0.1",
    "fastify": "5.12.1",
    "pino": "9.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.10.5",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.71.1",
    "vitest": "2.1.8"
  }
}
